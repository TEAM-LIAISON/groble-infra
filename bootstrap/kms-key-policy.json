{
  "Version": "2012-10-17",
  "Id": "groble-terraform-state-key",
  "Statement": [
    {
      "Sid": "EnableAccountKeyAdministration",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::538827147369:root" },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "AllowTerraformPrincipalUse",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::538827147369:root" },
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:ReEncrypt*",
        "kms:GenerateDataKey*",
        "kms:DescribeKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::538827147369:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_TerraformPowerUser_*",
            "arn:aws:iam::538827147369:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AdministratorAccess_*"
          ]
        }
      }
    }
  ]
}

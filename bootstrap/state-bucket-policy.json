{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::groble-terraform-state",
        "arn:aws:s3:::groble-terraform-state/*"
      ],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    },
    {
      "Sid": "DenyPrincipalsOutsideTerraform",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::groble-terraform-state",
        "arn:aws:s3:::groble-terraform-state/*"
      ],
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::538827147369:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_TerraformPowerUser_*",
            "arn:aws:iam::538827147369:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AdministratorAccess_*",
            "arn:aws:iam::538827147369:root"
          ]
        }
      }
    }
  ]
}
